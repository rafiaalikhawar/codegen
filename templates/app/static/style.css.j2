/* Design tokens - accent hue is derived from the domain name */
:root {
  --hue: {{ hue }};
  --brand: hsl(var(--hue) 78% 46%);
  --brand-2: hsl(calc(var(--hue) + 38) 80% 52%);
  --brand-ink: hsl(var(--hue) 70% 30%);
  --brand-soft: hsl(var(--hue) 90% 96%);
  --bg: #f7f7fb; --surface: #ffffff; --surface-2: #f1f2f7; --text: #14161f; --muted: #6a6f80;
  --border: #e4e6ee; --danger: #d92d20; --danger-soft: #fef0ee; --good: #067647; --good-soft: #e7f8ee;
  --shadow: 0 1px 2px rgba(20,22,31,.06), 0 8px 24px rgba(20,22,31,.06);
  --shadow-lg: 0 2px 4px rgba(20,22,31,.08), 0 18px 40px rgba(20,22,31,.12);
  --radius: 16px; --radius-sm: 10px;
}
@media (prefers-color-scheme: dark) {
  :root { --brand: hsl(var(--hue) 80% 62%); --brand-ink: hsl(var(--hue) 85% 78%); --brand-soft: hsl(var(--hue) 35% 16%);
    --bg: #0d0f15; --surface: #161924; --surface-2: #1d2130; --text: #eceef5; --muted: #9aa0b4; --border: #272b3b;
    --danger: #ff7066; --danger-soft: #3a1b19; --good: #4ade80; --good-soft: #12301f;
    --shadow: 0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.35); --shadow-lg: 0 18px 40px rgba(0,0,0,.5); }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
  background: var(--bg); color: var(--text); line-height: 1.55; min-height: 100vh; display: flex; flex-direction: column;
  -webkit-font-smoothing: antialiased; }
a { color: var(--brand-ink); text-decoration: none; } a:hover { text-decoration: underline; }
h1, h2, h3 { line-height: 1.2; letter-spacing: -.02em; margin: 0; }
.muted { color: var(--muted); }
.ico { width: 18px; height: 18px; flex: none; }

/* header */
.site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--surface) 82%, transparent);
  backdrop-filter: saturate(1.6) blur(14px); border-bottom: 1px solid var(--border); }
.navbar { max-width: 1200px; margin: 0 auto; padding: 10px 20px; display: flex; align-items: center; gap: 20px; }
.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.05rem; color: var(--text); letter-spacing: -.02em; }
.brand:hover { text-decoration: none; }
.logo { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; color: #fff; font-weight: 800;
  background: linear-gradient(135deg, var(--brand), var(--brand-2)); box-shadow: 0 4px 12px color-mix(in srgb, var(--brand) 45%, transparent); }
.nav-links { display: flex; gap: 4px; flex: 1; overflow-x: auto; scrollbar-width: none; }
.nav-links a { display: flex; align-items: center; gap: 7px; padding: 8px 12px; border-radius: 999px; color: var(--muted); font-weight: 500; white-space: nowrap; }
.nav-links a:hover { background: var(--surface-2); color: var(--text); text-decoration: none; }
.nav-search input { width: 220px; border-radius: 999px; background: var(--surface-2); border: 1px solid transparent; padding: 9px 16px; }
.nav-search input:focus { background: var(--surface); }
.nav-toggle { display: none; background: none; border: 0; font-size: 1.4rem; color: var(--text); cursor: pointer; margin-left: auto; }

.container { max-width: 1200px; width: 100%; margin: 0 auto; padding: 28px 20px 64px; flex: 1; }
.site-footer { text-align: center; color: var(--muted); padding: 24px; font-size: .85rem; border-top: 1px solid var(--border); }

/* controls */
input, select, textarea { font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 10px 14px; width: 100%; transition: border-color .15s, box-shadow .15s; }
input:focus, select:focus, textarea:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand) 18%, transparent); }
.btn, button.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; cursor: pointer; font: inherit; font-weight: 600;
  padding: 10px 18px; border-radius: 999px; color: #fff; background: linear-gradient(135deg, var(--brand), var(--brand-2));
  box-shadow: 0 6px 16px color-mix(in srgb, var(--brand) 32%, transparent); transition: transform .12s, box-shadow .12s; }
.btn:hover { transform: translateY(-1px); text-decoration: none; box-shadow: 0 10px 22px color-mix(in srgb, var(--brand) 38%, transparent); }
.btn.secondary { background: var(--surface); color: var(--text); border: 1px solid var(--border); box-shadow: none; }
.btn.danger { background: var(--danger); box-shadow: none; } .btn.danger-soft { background: var(--danger-soft); color: var(--danger); box-shadow: none; }
button.link { background: none; border: 0; padding: 0; font: inherit; cursor: pointer; text-decoration: underline; color: var(--brand-ink); }
button.link.danger { color: var(--danger); }

/* page chrome */
.page-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
.page-head h1 { font-size: 2rem; }
.crumbs { font-size: .85rem; color: var(--muted); margin-bottom: 14px; } .crumbs a { color: var(--muted); }
.toolbar { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
.toolbar .search { flex: 1; min-width: 220px; max-width: 420px; }
.sorter { display: flex; gap: 8px; } .sorter select { width: auto; padding: 9px 12px; }
.view-toggle { display: inline-flex; background: var(--surface-2); border-radius: 999px; padding: 3px; margin-left: auto; }
.view-toggle button { border: 0; background: none; color: var(--muted); padding: 6px 12px; border-radius: 999px; cursor: pointer; font-size: 1rem; }
.view[data-view="grid"] ~ * {} .view-toggle button.on { background: var(--surface); color: var(--text); box-shadow: var(--shadow); }
.chips { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 18px; }
.chip { padding: 6px 14px; border-radius: 999px; background: var(--surface); border: 1px solid var(--border); color: var(--text); font-size: .9rem; font-weight: 500; }
.chip:hover { text-decoration: none; border-color: var(--brand); } .chip.on { background: var(--brand); border-color: var(--brand); color: #fff; }

/* hero + stats */
.hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 28px; align-items: center; padding: 40px; border-radius: 28px; margin-bottom: 36px; color: #fff;
  background: radial-gradient(1200px 400px at 90% -20%, rgba(255,255,255,.25), transparent), linear-gradient(135deg, var(--brand), var(--brand-2));
  box-shadow: var(--shadow-lg); }
.hero h1 { font-size: clamp(2rem, 4vw, 3rem); margin: 8px 0 10px; }
.eyebrow { text-transform: uppercase; letter-spacing: .14em; font-size: .75rem; font-weight: 700; opacity: .85; margin: 0; }
.lead { opacity: .92; max-width: 46ch; margin: 0 0 22px; }
.hero-search { display: flex; gap: 8px; background: rgba(255,255,255,.18); padding: 6px; border-radius: 999px; max-width: 480px; backdrop-filter: blur(6px); }
.hero-search input { border: 0; background: rgba(255,255,255,.95); color: #14161f; border-radius: 999px; }
.hero-search .btn { background: #14161f; box-shadow: none; }
.stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.stat { display: grid; gap: 2px; padding: 16px; background: rgba(255,255,255,.16); border-radius: 18px; color: #fff; backdrop-filter: blur(6px); }
.stat:hover { background: rgba(255,255,255,.26); text-decoration: none; } .stat strong { font-size: 1.8rem; line-height: 1; } .stat span { opacity: .85; font-size: .85rem; }
.shelf { margin-bottom: 36px; } .shelf-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; } .shelf-head h2 { font-size: 1.35rem; }

/* product cards */
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 18px; }
.pcard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column;
  transition: transform .18s, box-shadow .18s, border-color .18s; }
.pcard:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: transparent; }
.pimg, .detail-img { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden;
  background: linear-gradient(135deg, hsl(var(--h) 75% 62%), hsl(calc(var(--h) + 40) 70% 46%)); }
.pimg img, .detail-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.pcard:hover .pimg img { transform: scale(1.06); }
.avatar { position: absolute; inset: 0; display: grid; place-items: center; font-size: 2.4rem; font-weight: 800; color: rgba(255,255,255,.85); }
.avatar.big { font-size: 5rem; }
.pbody { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
.pbody h3 { font-size: 1.02rem; } .pbody h3 a { color: var(--text); }
.sub { margin: 0; color: var(--muted); font-size: .85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sub span { color: var(--muted); opacity: .7; margin-right: 6px; } .sub span::after { content: ":"; }
.pfoot { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 10px; }
.price { font-weight: 800; font-size: 1.15rem; letter-spacing: -.02em; } .price.big { font-size: 2rem; margin: 6px 0 14px; }
.chip-btn { padding: 6px 14px; border-radius: 999px; background: var(--brand-soft); color: var(--brand-ink); font-weight: 600; font-size: .85rem; }
.chip-btn:hover { background: var(--brand); color: #fff; text-decoration: none; }
.badges { display: flex; gap: 6px; flex-wrap: wrap; }
.badge { font-size: .72rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; text-transform: capitalize; background: var(--surface-2); color: var(--muted); }
.badge.good { background: var(--good-soft); color: var(--good); }
.badge.tone0 { background: hsl(215 90% 94%); color: hsl(215 70% 35%); } .badge.tone1 { background: hsl(280 80% 94%); color: hsl(280 55% 38%); }
.badge.tone2 { background: hsl(35 95% 90%); color: hsl(30 80% 30%); } .badge.tone3 { background: hsl(160 70% 90%); color: hsl(160 70% 24%); }
.badge.tone4 { background: hsl(340 85% 93%); color: hsl(340 65% 36%); }
@media (prefers-color-scheme: dark) { .badge[class*="tone"] { background: var(--surface-2); color: var(--text); } }

/* table view */
.view[data-view="grid"] .view-table, .view[data-view="table"] .view-grid { display: none; }
.table-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
table { width: 100%; border-collapse: collapse; } th, td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
th { font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); background: var(--surface-2); }
tr:last-child td { border-bottom: 0; } tbody tr:hover { background: var(--surface-2); }
.actions { white-space: nowrap; } .actions form { display: inline; margin-left: 10px; } .actions a { margin-right: 4px; }
.pager { display: flex; gap: 14px; justify-content: center; align-items: center; margin-top: 24px; }

/* detail */
.detail-hero { display: grid; grid-template-columns: minmax(260px, 420px) 1fr; gap: 32px; margin-bottom: 28px; }
.detail-img { border-radius: var(--radius); box-shadow: var(--shadow); aspect-ratio: 1; }
.detail-main h1 { font-size: 2.2rem; margin: 10px 0 4px; } .header-actions { display: flex; gap: 8px; margin-bottom: 18px; }
.details { display: grid; grid-template-columns: max-content 1fr; gap: 10px 28px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; margin: 0; }
.details dt { color: var(--muted); font-weight: 500; } .details dd { margin: 0; font-weight: 500; }
.panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; margin-bottom: 16px; }
.panel h2 { font-size: 1.1rem; margin-bottom: 10px; } .link-list { padding-left: 18px; margin: 0 0 12px; } .link-list li { padding: 4px 0; } .link-list form { display: inline; margin-left: 12px; }
.inline-form { display: flex; gap: 8px; flex-wrap: wrap; } .inline-form select { max-width: 360px; }

/* forms */
.record-form { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; max-width: 760px; box-shadow: var(--shadow); }
.form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px 20px; } .form-group.wide { grid-column: 1 / -1; }
label { display: block; font-weight: 600; font-size: .9rem; margin-bottom: 6px; } .req { color: var(--danger); }
.has-error input, .has-error select, .has-error textarea { border-color: var(--danger); } .field-error { color: var(--danger); margin: 6px 0 0; font-size: .85rem; }
.form-actions { display: flex; gap: 10px; margin-top: 26px; }
.switch { position: relative; display: inline-block; width: 46px; height: 26px; margin: 0; }
.switch input { opacity: 0; width: 0; height: 0; } .slider { position: absolute; inset: 0; background: var(--border); border-radius: 999px; transition: .2s; cursor: pointer; }
.slider::before { content: ""; position: absolute; width: 20px; height: 20px; left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: .2s; box-shadow: 0 1px 3px rgba(0,0,0,.3); }
.switch input:checked + .slider { background: var(--brand); } .switch input:checked + .slider::before { transform: translateX(20px); }

/* feedback */
.alert { padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 18px; } .alert.error { background: var(--danger-soft); color: var(--danger); }
.toast { position: fixed; right: 20px; bottom: 20px; z-index: 50; padding: 12px 18px; border-radius: 14px; box-shadow: var(--shadow-lg); font-weight: 600;
  background: var(--text); color: var(--bg); animation: toast 4.5s ease forwards; max-width: 360px; }
.toast.success { background: var(--good); color: #fff; } .toast.error { background: var(--danger); color: #fff; }
@keyframes toast { 0% { transform: translateY(20px); opacity: 0; } 8%, 85% { transform: none; opacity: 1; } 100% { transform: translateY(10px); opacity: 0; visibility: hidden; } }
.empty { text-align: center; padding: 56px 20px; background: var(--surface); border: 1px dashed var(--border); border-radius: var(--radius); display: grid; gap: 10px; justify-items: center; }
.empty.small { padding: 28px; } .empty-art { width: 72px; height: 72px; border-radius: 22px; display: grid; place-items: center; background: var(--brand-soft); color: var(--brand); }
.empty-art .ico { width: 34px; height: 34px; } .big-code { font-size: 4rem; color: var(--brand); }
dialog { border: 0; border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow-lg); background: var(--surface); color: var(--text); max-width: 380px; }
dialog::backdrop { background: rgba(10,12,20,.55); backdrop-filter: blur(3px); } .dialog-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 18px; }

@media (max-width: 860px) {
  .hero { grid-template-columns: 1fr; padding: 28px; } .detail-hero { grid-template-columns: 1fr; }
  .nav-toggle { display: block; } .nav-search { display: none; }
  .navbar { flex-wrap: wrap; } .nav-links { display: none; width: 100%; flex-direction: column; order: 3; } .nav-links.open { display: flex; }
  .form-grid { grid-template-columns: 1fr; } .page-head h1 { font-size: 1.6rem; } .details { grid-template-columns: 1fr; gap: 2px; }
  .details dt { margin-top: 10px; } .grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
  thead { display: none; } table, tbody, tr, td { display: block; width: 100%; } tr { padding: 10px 0; border-bottom: 1px solid var(--border); }
  td { border: 0; padding: 4px 16px; } td[data-label]::before { content: attr(data-label) ": "; font-weight: 600; color: var(--muted); }
}
@media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
